{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "protocol": {
      "type": "string",
      "const": "orbistry.engine/1"
    },
    "engine_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "engine_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[a-zA-Z0-9.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "entry": {
      "type": "string",
      "maxLength": 200
    },
    "operations": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "input_schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "output_schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "read_only": {
            "type": "boolean",
            "const": true
          },
          "network": {
            "type": "string",
            "enum": ["none", "outbound"]
          },
          "timeout_ms": {
            "default": 10000,
            "type": "integer",
            "minimum": 100,
            "maximum": 120000
          }
        },
        "required": [
          "id",
          "description",
          "input_schema",
          "output_schema",
          "read_only",
          "network",
          "timeout_ms"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "signature": {
      "type": "object",
      "properties": {
        "signature_version": {
          "type": "number",
          "const": 1
        },
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "public_key": {
          "type": "string",
          "maxLength": 1024
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "signature_version",
        "algorithm",
        "key_id",
        "public_key",
        "manifest_digest",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "protocol",
    "engine_id",
    "engine_version",
    "name",
    "description",
    "entry",
    "operations",
    "files"
  ],
  "additionalProperties": false
}
