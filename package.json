{
  "name": "orbistry",
  "version": "1.0.6",
  "description": "Local-first AI-native knowledge and research workspace",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:icons": "node scripts/build/prepare-icons.cjs",
    "prepare:pdf": "node scripts/build/prepare-pdf-worker.cjs",
    "dev": "npm run prepare:icons && npm run prepare:pdf && concurrently -k \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "next dev",
    "dev:desktop": "wait-on tcp:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 node electron/launch.cjs",
    "build": "npm run prepare:icons && npm run prepare:pdf && next build && node scripts/build/secure-export.cjs",
    "start": "node electron/launch.cjs",
    "desktop:preview": "npm run build && node electron/launch.cjs",
    "desktop:dist": "npm run build && electron-builder",
    "package": "npm run build && electron-builder --win --x64 --dir && node scripts/audit/audit-package.cjs",
    "release": "npm run build && electron-builder --win --x64 && node scripts/audit/audit-package.cjs",
    "test:release:electron": "npm run build && node scripts/acceptance/electron-release-smoke.cjs",
    "test:packaged:electron": "node scripts/acceptance/electron-packaged-smoke.cjs",
    "audit:size": "node scripts/audit/release-size-audit.cjs",
    "audit:source": "node scripts/audit/audit-source.cjs",
    "audit:architecture": "node scripts/audit/audit-architecture.cjs",
    "atlas:generate": "node scripts/code-atlas.cjs",
    "atlas:check": "node scripts/code-atlas.cjs --check",
    "test:atlas": "node --test scripts/code-atlas/atlas.test.cjs",
    "engine": "node scripts/orbistry-engine.cjs",
    "test:engine:registry": "node --test electron/engine-packages.test.cjs",
    "test:m72:live": "node scripts/m72-live-proof.cjs",
    "test:m74:live": "node scripts/m72-live-proof.cjs",
    "test": "node --experimental-strip-types --test \"electron/**/*.test.cjs\" \"features/**/*.test.cjs\" \"scripts/code-atlas/*.test.cjs\" \"tests/integration/**/*.test.cjs\"",
    "typecheck": "tsc --noEmit",
    "test:chat:live": "node scripts/chat-live-acceptance.cjs",
    "test:dataset:live": "node scripts/dataset-live-acceptance.cjs",
    "test:dataset:electron": "npm run build && node scripts/dataset-electron-acceptance.cjs",
    "test:chat:online": "node scripts/chat-live-acceptance.cjs --gemini",
    "test:chat:online:electron": "npm run build && node scripts/acceptance/electron-online-chat-smoke.cjs",
    "test:agent:electron": "npm run build && node scripts/agent-electron-acceptance.cjs",
    "test:chat:electron": "npm run build && node scripts/acceptance/electron-chat-smoke.cjs",
    "format:integration": "prettier --write \"features/**/*.{ts,tsx,cjs,css}\" \"electron/ai/**/*.cjs\" electron/main.cjs electron/preload.cjs types/ai.ts types/electron.d.ts components/app-shell.tsx components/chat-panel.tsx components/top-bar.tsx \"scripts/*chat*.cjs\" scripts/acceptance/electron-smoke-main.cjs",
    "format:check": "prettier --check \"features/**/*.{ts,tsx,cjs,css}\" \"electron/ai/**/*.cjs\" electron/main.cjs electron/preload.cjs types/ai.ts types/electron.d.ts components/app-shell.tsx components/chat-panel.tsx components/top-bar.tsx \"scripts/*chat*.cjs\" scripts/acceptance/electron-smoke-main.cjs",
    "test:chat:openrouter:electron": "npm run build && node scripts/acceptance/electron-openrouter-smoke.cjs",
    "test:agent:workspace:electron": "npm run build && node scripts/acceptance/electron-agent-workspace-smoke.cjs",
    "test:usage:electron": "npm run build && node scripts/acceptance/electron-usage-monitor-smoke.cjs",
    "test:victoria:electron": "npm run build && node scripts/acceptance/electron-victoria-smoke.cjs",
    "test:ui-polish:electron": "npm run build && node scripts/acceptance/electron-ui-polish-smoke.cjs",
    "test:surfaces:electron": "npm run build && node scripts/acceptance/electron-soft-surfaces-smoke.cjs",
    "test:chronoz:electron": "npm run build && node scripts/acceptance/electron-chronoz-smoke.cjs",
    "test:startup:electron": "npm run build && node scripts/acceptance/electron-startup-smoke.cjs",
    "test:knowledge:electron": "npm run build && node scripts/acceptance/electron-knowledge-smoke.cjs",
    "test:construction:electron": "npm run build && node scripts/acceptance/electron-construction-smoke.cjs",
    "test:engine:electron": "npm run build && node scripts/acceptance/electron-engine-smoke.cjs",
    "test:engine:chat:live": "node scripts/engine-chat-live.cjs",
    "test:appearance:electron": "npm run build && node scripts/acceptance/electron-appearance-smoke.cjs",
    "test:box-agents:electron": "npm run build && node scripts/acceptance/electron-box-agents-smoke.cjs",
    "test:add-agent:electron": "npm run build && node scripts/acceptance/electron-add-agent-smoke.cjs",
    "test:single-file:electron": "npm run build && node scripts/acceptance/electron-single-file-smoke.cjs",
    "test:message-retry:electron": "npm run build && node scripts/acceptance/electron-message-retry-smoke.cjs",
    "test:pdf-image:electron": "npm run build && node scripts/acceptance/electron-pdf-image-smoke.cjs",
    "test:markdown:electron": "npm run build && node scripts/acceptance/electron-markdown-editor-smoke.cjs",
    "test:runtime-kernel:electron": "npm run build && node scripts/acceptance/electron-runtime-kernel-smoke.cjs",
    "report:runtime-kernel": "node scripts/runtime-kernel-report.cjs",
    "test:front-office": "node --test electron/ai/front-office*.test.cjs",
    "test:front-office:electron": "npm run build && node scripts/acceptance/electron-front-office-smoke.cjs",
    "benchmark:front-office": "node scripts/front-office-benchmark.cjs --mock",
    "benchmark:front-office:live": "node scripts/front-office-benchmark.cjs --live",
    "test:worldview:electron": "npm run build && node scripts/acceptance/electron-worldview-smoke.cjs",
    "test:identity:electron": "npm run build && node scripts/acceptance/electron-backend-identity-smoke.cjs",
    "test:entity-agents:electron": "npm run build && node scripts/acceptance/electron-entity-agents-smoke.cjs",
    "test:entity-runtime:live": "npm run build && node scripts/acceptance/electron-entity-runtime-live.cjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "js-yaml": "^4.3.2",
    "pdfjs-dist": "^6.2.108",
    "sax": "1.6.1",
    "ssf": "0.11.2",
    "unzipper": "0.12.5",
    "yahoo-finance2": "4.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^7.0.3",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "next": "^16.4.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "asar": true,
    "compression": "maximum",
    "artifactName": "ORB-Terminal-${version}-Victoria-Beta-${os}-${arch}.${ext}",
    "asarUnpack": [
      "electron/windows-ocr.ps1"
    ],
    "appId": "com.orbistry.desktop",
    "productName": "ORB Terminal",
    "files": [
      "out/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "!electron/**/*.d.cts",
      "!electron/ai/policies/orbistry-host-policy-v19.md",
      "!**/*.map",
      "!**/node_modules/next/**",
      "!**/node_modules/react/**",
      "!**/node_modules/react-dom/**",
      "!**/node_modules/@next/**",
      "build/icon.png",
      "build/orbistry-window-icon.png",
      "build/orb-terminal.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/orb-terminal.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
